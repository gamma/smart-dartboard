# Published image and immutable release version.
SDB_IMAGE=ghcr.io/gamma/smart-dartboard
SDB_VERSION=0.0.2

# The tested Kings Dart board advertises itself as SDB-BT.
SDB_DEVICE_NAME=SDB-BT

# Recommended for a permanent arcade installation. Leave empty for name-based
# discovery during initial setup.
SDB_DEVICE_ADDRESS=

# Production defaults for a Linux host with BlueZ. For a UI-only start on
# Docker Desktop, set SDB_ENABLE_BLE=0 and SDB_ALLOW_TEST_EVENTS=1.
SDB_ENABLE_BLE=1
SDB_ALLOW_TEST_EVENTS=0
