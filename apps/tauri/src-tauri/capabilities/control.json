{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "control",
  "description": "Interactive controller can read and mutate the M0 runtime.",
  "windows": ["control"],
  "permissions": [
    "core:default",
    "allow-runtime-bootstrap",
    "allow-runtime-query",
    "allow-runtime-dispatch",
    "allow-companion-pairing-open",
    "allow-companion-devices",
    "allow-companion-revoke",
    "allow-companion-discovery-start",
    "allow-companion-discovered-hosts",
    "allow-companion-discovery-stop",
    "allow-projector-output-select"
  ]
}
