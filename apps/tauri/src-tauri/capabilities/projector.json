{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "projector",
  "description": "Projector receives state events but cannot mutate the runtime.",
  "windows": ["projector"],
  "permissions": [
    "core:default",
    "allow-runtime-bootstrap",
    "allow-runtime-query",
    "allow-runtime-v2-bootstrap",
    "allow-runtime-v2-snapshot",
    "allow-runtime-v2-ack-effect",
    "allow-runtime-v2-query",
    "allow-runtime-v2-report",
    "allow-runtime-v2-projector-test-event"
  ]
}
