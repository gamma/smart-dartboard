FROM rust:1.97-bookworm AS builder

WORKDIR /source
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
RUN cargo build --locked --release -p sdb-server

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin dartboard \
    && install -d -o dartboard -g dartboard /app /data

WORKDIR /app
COPY --from=builder /source/target/release/sdb-server /usr/local/bin/sdb-server
COPY --chown=dartboard:dartboard web /app/web

ENV SDB_DATA_DIR=/data \
    SDB_ENABLE_BLE=0 \
    SDB_WEB_DIR=/app/web \
    SDB_PORT=8000

USER dartboard
EXPOSE 8000
VOLUME ["/data"]

HEALTHCHECK --interval=20s --timeout=4s --start-period=5s --retries=3 \
    CMD ["curl", "--fail", "--silent", "--show-error", "http://127.0.0.1:8000/api/v2/health"]

ENTRYPOINT ["sdb-server"]
